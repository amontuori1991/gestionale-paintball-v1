@using System.Globalization
@using Full_Metal_Paintball_Carmagnola.Models
@model IEnumerable<Full_Metal_Paintball_Carmagnola.Models.Partita>

@{
    var staffDefault = ViewBag.StaffList as List<string> ?? new List<string>();
    var staffDisponibiliPerData = ViewBag.StaffDisponibiliPerData as Dictionary<DateTime, List<string>>;
    var staffStatiPerData = ViewBag.StaffStatiPerData as Dictionary<DateTime, Dictionary<string, bool?>>;
    string StaffOptionLabel(DateTime data, string nome)
    {
        var disponibile = staffStatiPerData != null && staffStatiPerData.TryGetValue(data.Date, out var stati)
            && stati.TryGetValue(nome, out var stato) && stato == true;
        return $"{(disponibile ? "✅" : "⏳")} {nome}";
    }
    var listinoLabels = ViewBag.ListinoLabels as IDictionary<short, string> ?? new Dictionary<short, string>();
    var weatherByPartitaId = ViewBag.WeatherByPartitaId as IReadOnlyDictionary<int, Full_Metal_Paintball_Carmagnola.Models.PartitaWeatherViewModel>
        ?? new Dictionary<int, Full_Metal_Paintball_Carmagnola.Models.PartitaWeatherViewModel>();
    short currentListinoId = ViewBag.CurrentListinoId is short currentValue ? currentValue : (short)2;

    var it = CultureInfo.GetCultureInfo("it-IT");
    var canAssignStaff = User.IsInRole("Admin");

    string GetListinoLabel(short id) =>
        listinoLabels.TryGetValue(id, out var label) ? label : $"Listino {id}";

    string Money(decimal amount) => $"{amount.ToString("0.00", it)}€";

    string ReferenteLabel(Partita partita) =>
        !string.IsNullOrWhiteSpace(partita.NomeRiferimento)
            ? partita.NomeRiferimento.Trim()
            : partita.Riferimento?.Trim() ?? string.Empty;

    string TipoLabel(Partita partita) =>
        (partita.Tipo?.Equals("kids", StringComparison.OrdinalIgnoreCase) ?? false)
            ? "KIDS"
            : (string.IsNullOrWhiteSpace(partita.Tipo) ? "ADULTI" : partita.Tipo.ToUpperInvariant());

    string TesseratiNames(Partita partita)
    {
        var tesserati = partita.Tesseramenti ?? new List<Tesseramento>();
        var names = tesserati
            .OrderBy(t => t.Cognome)
            .ThenBy(t => t.Nome)
            .Select(t => $"{t.Nome} {t.Cognome}".Trim())
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();

        return names.Any()
            ? string.Join("\n", names)
            : "Nessun tesseramento ricevuto al momento";
    }

    string RiferimentoDettaglio(Partita partita)
    {
        var parts = new List<string>();
        var referente = ReferenteLabel(partita);
        if (!string.IsNullOrWhiteSpace(referente))
            parts.Add(referente);

        if (!string.IsNullOrWhiteSpace(partita.PrefissoTelefonoRiferimento) || !string.IsNullOrWhiteSpace(partita.TelefonoRiferimento))
            parts.Add($"{partita.PrefissoTelefonoRiferimento} {partita.TelefonoRiferimento}".Trim());

        return parts.Count > 0 ? string.Join(" - ", parts) : "Nessun riferimento indicato";
    }

    string? WhatsappUrl(Partita partita)
    {
        var prefix = new string((partita.PrefissoTelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        var number = new string((partita.TelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(prefix) || string.IsNullOrWhiteSpace(number))
            return null;

        return $"https://wa.me/{prefix}{number}";
    }

    string? WhatsappNumber(Partita partita)
    {
        var prefix = new string((partita.PrefissoTelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        var number = new string((partita.TelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(prefix) || string.IsNullOrWhiteSpace(number))
            return null;

        return $"{prefix}{number}";
    }

    string PhoneSearchValue(Partita partita)
    {
        var prefix = new string((partita.PrefissoTelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        var number = new string((partita.TelefonoRiferimento ?? string.Empty).Where(char.IsDigit).ToArray());
        return $"{prefix}{number} {number}".Trim();
    }

    string AbsoluteUrl(string relativeUrl)
    {
        var request = Context.Request;
        return $"{request.Scheme}://{request.Host}{relativeUrl}";
    }

    string JsString(string value) => System.Text.Json.JsonSerializer.Serialize(value);

}

<!-- =========================
     DESKTOP/TABLET: TABELLA
     ========================= -->
<div class="table-scroll partite-table-desktop">
    <table class="table table-bordered responsive-table">
        <thead>
            <tr>
                <th>Stato</th>
                <th>Data</th>
                <th>Ora</th>
                <th>Tipo</th>
                <th>Lingua</th>
                <th>Rif.</th>
                <th>Durata</th>
                <th>Nr. P.</th>
                <th>Iscritti</th>
                <th>Caparra</th>
                <th>Listino</th>
                <th>Torneo</th>
                <th>Illimitati</th>
                <th>Caccia</th>
                <th>WhatsApp</th>
                <th>Tesserati</th>
                <th>Azioni</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var partita in Model)
            {
                var isInfrasett = partita.Data.DayOfWeek != DayOfWeek.Saturday && partita.Data.DayOfWeek != DayOfWeek.Sunday;
                var iscritti = partita.Tesseramenti?.Count ?? 0;
                var iscrittiClass = iscritti == partita.NumeroPartecipanti
                    ? "iscritti-count--ok"
                    : iscritti < partita.NumeroPartecipanti
                        ? "iscritti-count--under"
                        : "iscritti-count--over";
                weatherByPartitaId.TryGetValue(partita.Id, out var weather);

                <tr id="partita-row-@partita.Id"
                    class="partita-row @(isInfrasett ? "bg-infrasett" : "")"
                    data-partita-id="@partita.Id"
                    data-filter-reference="@ReferenteLabel(partita)"
                    data-filter-phone="@PhoneSearchValue(partita)">


                    <td data-label="Stato">
                        @if (partita.IsDeleted)
                        {
                            <span style="background-color: #f8d7da; color: #842029; padding: 4px 8px; border-radius: 5px; font-weight: 700;">Cancellata</span>
                        }
                        else if (partita.CaparraConfermata)
                        {
                            <span style="background-color: #d4edda; padding: 4px 8px; border-radius: 5px;">Confermata</span>
                        }
                        else
                        {
                            <span style="background-color: #fff3cd; padding: 4px 8px; border-radius: 5px;">In Attesa</span>
                        }
                    </td>

                    <td data-label="Data">
                        @(partita.Data.ToString("ddd dd/MM/yyyy", it).ToLowerInvariant().Replace(".", ""))
                    </td>

                    <td data-label="Ora Inizio">@partita.OraInizio.ToString(@"hh\:mm")</td>
                    <td data-label="Tipo">@partita.Tipo</td>
                    <td data-label="Lingua">@(string.Equals(partita.Nazionalita, "ENG", StringComparison.OrdinalIgnoreCase) ? "ENG" : "ITA")</td>

                    <td data-label="Riferimento">
                        <span class="ref-icon" onclick="showRiferimento(@JsString(RiferimentoDettaglio(partita)))">📇</span>
                    </td>

                    <td data-label="Durata">@partita.Durata</td>
                    <td data-label="Partecipanti">@partita.NumeroPartecipanti</td>
                    <td data-label="Iscritti">
                        <span class="iscritti-count @iscrittiClass">@iscritti</span>
                    </td>
                    <td data-label="Caparra">@Money(partita.Caparra)</td>

                    <td data-label="Listino">@GetListinoLabel(partita.Listino)</td>

                    <td data-label="Torneo" class="@(partita.Torneo ? "yes" : "no")">@((partita.Torneo) ? "SI" : "NO")</td>
                    <td data-label="Illimitati" class="@(partita.ColpiIllimitati ? "yes" : "no")">@((partita.ColpiIllimitati) ? "SI" : "NO")</td>
                    <td data-label="Caccia" class="@(partita.Caccia ? "yes" : "no")">
    @(partita.Caccia
        ? (partita.CacciaDoppia ? "SI x2" : "SI")
        : "NO")
</td>



                    <td data-label="WhatsApp">
                        @{
                            var whatsappUrl = WhatsappUrl(partita);
                            var whatsappNumber = WhatsappNumber(partita);
                        }
                        @if (!string.IsNullOrWhiteSpace(whatsappUrl))
                        {
                            <button type="button"
                                    class="icon-link text-success btn-whatsapp-actions"
                                    title="Azioni WhatsApp con @ReferenteLabel(partita)"
                                    data-id="@partita.Id"
                                    data-wa-number="@whatsappNumber"
                                    data-wa-chat-url="@whatsappUrl"
                                    data-referente="@ReferenteLabel(partita)"
                                    data-date="@partita.Data.ToString("dd/MM/yyyy")"
                                    data-time="@partita.OraInizio.ToString(@"hh\:mm")"
                                    data-duration="@partita.Durata"
                                    data-participants="@partita.NumeroPartecipanti"
                                    data-registered="@iscritti"
                                    data-members-names="@TesseratiNames(partita)"
                                    data-type="@TipoLabel(partita)"
                                    data-language="@(string.Equals(partita.Nazionalita, "ENG", StringComparison.OrdinalIgnoreCase) ? "ENG" : "ITA")"
                                    data-caparra="@Money(partita.Caparra)"
                                    data-payment-method="@partita.MetodoPagamentoCaparra"
                                    data-deposit-date="@partita.Data.ToString("dd MMMM", it)"
                                    data-deposit-date-en="@partita.Data.ToString("dd MMMM", CultureInfo.GetCultureInfo("en-GB"))"
                                    data-caparra-en="@(partita.Caparra.ToString("0.00", CultureInfo.InvariantCulture)) EUR"
                                    data-tesseramento-url="@AbsoluteUrl(Url.Action("Index", "Tesseramento", new { partitaId = partita.Id }) ?? string.Empty)">
                                <i class="bi bi-whatsapp" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            <span style="opacity:.35;">-</span>
                        }
                    </td>

                    <td data-label="Tesserati">
                        <a class="btn btn-sm btn-info" href="@Url.Action("TesseratiPerPartita", "Partite", new { id = partita.Id })">Mostra</a>
                    </td>

                    <td data-label="Azioni">
                        <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Partite", new { id = partita.Id })">✏️</a>
                        <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "Partite", new { id = partita.Id })">🗑️</a>
                        <button class="btn btn-sm btn-primary btn-invia-recensione" data-id="@partita.Id" title="Invia richiesta recensione">📧</button>
                        <button class="btn btn-sm btn-secondary btn-messaggio-prenotazione" data-id="@partita.Id" title="Genera messaggio prenotazione">📄</button>
                    </td>
                </tr>

<tr class="partita-staff-row" data-parent-partita-id="@partita.Id" style="@(isInfrasett ? "background-color: #ffeeba;" : "")">
    <td colspan="17" style="background-color: inherit;">
        <span class="staff-weather-inline">
            @if (weather != null)
            {
                <span class="weather-pill weather-js"
                      data-weather-date="@partita.Data.ToString("yyyy-MM-dd")"
                      data-weather-time="@partita.OraInizio.ToString(@"hh\:mm")"
                      title="@weather.Summary">
                    <span class="weather-pill__icon">@weather.Icon</span>
                    <span class="weather-pill__text">@weather.Summary</span>
                </span>
            }
            else
            {
                <span class="weather-pill weather-pill--empty weather-js"
                      data-weather-date="@partita.Data.ToString("yyyy-MM-dd")"
                      data-weather-time="@partita.OraInizio.ToString(@"hh\:mm")"
                      title="Meteo in caricamento o non disponibile">
                    <span class="weather-pill__icon">-</span>
                    <span class="weather-pill__text">Meteo</span>
                </span>
            }
        </span>
        <strong>Gestita da:</strong>

                         @{
            var dataKey = partita.Data.Date;
            var staffList = ((staffDisponibiliPerData != null && staffDisponibiliPerData.TryGetValue(dataKey, out var lista))
                ? lista
                : staffDefault)
                .Where(s => staffDefault.Contains(s, StringComparer.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();
        }

 @foreach (var staff in new[] { "Staff1", "Staff2", "Staff3", "Staff4" })
{
    var prop = typeof(Full_Metal_Paintball_Carmagnola.Models.Partita).GetProperty(staff);
    var currentVal = prop?.GetValue(partita) as string ?? "";
    var currentIsInactive = !string.IsNullOrWhiteSpace(currentVal)
        && !staffDefault.Contains(currentVal, StringComparer.OrdinalIgnoreCase);

    @if (!canAssignStaff)
    {
        <span class="d-inline-block mx-1 py-1">@(string.IsNullOrWhiteSpace(currentVal) ? "--" : currentVal)</span>
    }
    else
    {
    <select class="form-select staff-select d-inline-block mx-1"
            data-campo="@staff" data-partita="@partita.Id">
        <option value="" selected="@(currentIsInactive ? "selected" : null)">--</option>
        @foreach (var s in staffList)
        {
            <option value="@s" selected="@(s == currentVal ? "selected" : null)">@StaffOptionLabel(partita.Data, s)</option>
        }
    </select>
    }
    @if (currentIsInactive)
    {
        <span class="text-muted small me-2">@currentVal non attivo</span>
    }
}


                        <span style="float: right;">
                            <strong>Reperibile:</strong> @partita.Reperibile
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                <a class="btn btn-sm btn-secondary booking-photo-button" href="@Url.Action("Gestisci", "Foto", new { id = partita.Id })" title="Album foto della partita" aria-label="Album foto della partita">&#128247; Foto</a>
                            }
                            <button class="btn btn-sm btn-info btn-verifica-presenze mx-2" data-data="@partita.Data.ToString("yyyy-MM-dd")">
                                Presenze Staff
                            </button>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- =========================
     MOBILE: CARD (SOLO MOBILE)
     ========================= -->
<div class="partite-cards-mobile pm-wrap">
@foreach (var partita in Model)
{
    var isInfrasett = partita.Data.DayOfWeek != DayOfWeek.Saturday && partita.Data.DayOfWeek != DayOfWeek.Sunday;
    var iscritti = partita.Tesseramenti?.Count ?? 0;
    var iscrittiClass = iscritti == partita.NumeroPartecipanti
        ? "iscritti-count--ok"
        : iscritti < partita.NumeroPartecipanti
            ? "iscritti-count--under"
            : "iscritti-count--over";

    var statoLabel = partita.IsDeleted
        ? "Cancellata"
        : (partita.CaparraConfermata ? "Confermata" : "In attesa");
    var statoClass = partita.IsDeleted
        ? "pm-status-deleted"
        : (partita.CaparraConfermata ? "pm-status-ok" : "pm-status-wait");
    weatherByPartitaId.TryGetValue(partita.Id, out var weather);

    var tipoLabel = TipoLabel(partita);

        <div id="partita-card-@partita.Id"
             class="pm-card @(isInfrasett ? "pm-infrasett" : "")"
             data-date="@partita.Data.ToString("yyyy-MM-dd")"
             data-partita-id="@partita.Id"
             data-filter-reference="@ReferenteLabel(partita)"
             data-filter-phone="@PhoneSearchValue(partita)">

        <div class="pm-weather-top">
            <div class="pm-weather weather-js @(weather == null ? "weather-pill--empty" : "")"
                 data-weather-date="@partita.Data.ToString("yyyy-MM-dd")"
                 data-weather-time="@partita.OraInizio.ToString(@"hh\:mm")"
                 title="@(weather?.Summary ?? "Meteo in caricamento o non disponibile")">
                <span class="weather-pill__icon">@(weather?.Icon ?? "-")</span>
                <small class="weather-pill__text">@(weather?.Summary ?? "Meteo")</small>
            </div>
        </div>

        <div class="pm-head">
            <div class="pm-left">
            <div class="pm-date">@partita.Data.ToString("ddd dd/MM", it).ToLowerInvariant().Replace(".", "")</div>
            <div class="pm-time">@partita.OraInizio.ToString(@"hh\:mm")</div>
            </div>
            <span class="pm-status @statoClass">@statoLabel</span>
        </div>

        <div class="pm-chips">
            <span class="pm-chip pm-chip-muted">@tipoLabel</span>
            <span class="pm-chip pm-chip-muted">@(string.Equals(partita.Nazionalita, "ENG", StringComparison.OrdinalIgnoreCase) ? "ENG" : "ITA")</span>
            <span class="pm-chip pm-chip-muted">@(partita.Listino == currentListinoId ? $"Listino attivo: {GetListinoLabel(partita.Listino)}" : GetListinoLabel(partita.Listino))</span>
            @if (partita.Torneo) { <span class="pm-chip pm-chip-gold">🏆 Torneo</span> }
            @if (partita.ColpiIllimitati) { <span class="pm-chip pm-chip-blue">♾️ Illimitati</span> }
            @if (partita.Caccia)
{
    <span class="pm-chip pm-chip-pink">🐰 Caccia @(partita.CacciaDoppia ? "x2" : "")</span>
}

        </div>

        <div class="pm-grid">
            <div class="pm-kv"><div class="pm-k">Durata</div><div class="pm-v">@partita.Durata h</div></div>
            <div class="pm-kv"><div class="pm-k">Nr. P.</div><div class="pm-v">@partita.NumeroPartecipanti</div></div>
            <div class="pm-kv"><div class="pm-k">Iscritti</div><div class="pm-v"><span class="iscritti-count @iscrittiClass">@iscritti</span></div></div>
            <div class="pm-kv"><div class="pm-k">Caparra</div><div class="pm-v">@Money(partita.Caparra)</div></div>
        </div>

        <div class="pm-row-actions">
            <button type="button" class="pm-iconbtn" onclick="showRiferimento(@JsString(RiferimentoDettaglio(partita)))" title="Riferimento">📇</button>
            @{
                var whatsappMobileUrl = WhatsappUrl(partita);
                var whatsappMobileNumber = WhatsappNumber(partita);
            }
            @if (!string.IsNullOrWhiteSpace(whatsappMobileUrl))
            {
                <button type="button"
                        class="pm-iconbtn pm-iconbtn--whatsapp btn-whatsapp-actions"
                        title="Azioni WhatsApp con @ReferenteLabel(partita)"
                        data-id="@partita.Id"
                        data-wa-number="@whatsappMobileNumber"
                        data-wa-chat-url="@whatsappMobileUrl"
                        data-referente="@ReferenteLabel(partita)"
                        data-date="@partita.Data.ToString("dd/MM/yyyy")"
                        data-time="@partita.OraInizio.ToString(@"hh\:mm")"
                        data-duration="@partita.Durata"
                        data-participants="@partita.NumeroPartecipanti"
                        data-registered="@iscritti"
                        data-members-names="@TesseratiNames(partita)"
                        data-type="@tipoLabel"
                        data-language="@(string.Equals(partita.Nazionalita, "ENG", StringComparison.OrdinalIgnoreCase) ? "ENG" : "ITA")"
                        data-caparra="@Money(partita.Caparra)"
                        data-payment-method="@partita.MetodoPagamentoCaparra"
                        data-deposit-date="@partita.Data.ToString("dd MMMM", it)"
                        data-deposit-date-en="@partita.Data.ToString("dd MMMM", CultureInfo.GetCultureInfo("en-GB"))"
                        data-caparra-en="@(partita.Caparra.ToString("0.00", CultureInfo.InvariantCulture)) EUR"
                        data-tesseramento-url="@AbsoluteUrl(Url.Action("Index", "Tesseramento", new { partitaId = partita.Id }) ?? string.Empty)">
                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                </button>
            }
            <a class="pm-primary" href="@Url.Action("TesseratiPerPartita", "Partite", new { id = partita.Id })">👥 Tesserati</a>
        </div>

        <details class="pm-details" open>

            <summary>Gestita da: </summary>
            <div class="pm-details-body">
 <div class="pm-staff-grid">
    @{
        var dataKey = partita.Data.Date;
        var staffList = ((staffDisponibiliPerData != null && staffDisponibiliPerData.TryGetValue(dataKey, out var lista))
            ? lista
            : staffDefault)
            .Where(s => staffDefault.Contains(s, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
    }

    @foreach (var staff in new[] { "Staff1", "Staff2", "Staff3", "Staff4" })
    {
        var currentVal = typeof(Full_Metal_Paintball_Carmagnola.Models.Partita).GetProperty(staff)?.GetValue(partita) as string ?? "";
        var currentIsInactive = !string.IsNullOrWhiteSpace(currentVal)
            && !staffDefault.Contains(currentVal, StringComparer.OrdinalIgnoreCase);

        @if (!canAssignStaff)
        {
            <span class="pm-select py-2">@(string.IsNullOrWhiteSpace(currentVal) ? "--" : currentVal)</span>
        }
        else
        {
        <select class="form-select staff-select pm-select" data-campo="@staff" data-partita="@partita.Id">
            <option value="" selected="@(currentIsInactive ? "selected" : null)">--</option>
            @foreach (var s in staffList)
            {
                <option value="@s" selected="@(s == currentVal ? "selected" : null)">@StaffOptionLabel(partita.Data, s)</option>
            }
        </select>
        }
        @if (currentIsInactive)
        {
            <span class="text-muted small">@currentVal non attivo</span>
        }
    }
</div>


                <div class="pm-rep">
                    <div><strong>Reperibile:</strong> @partita.Reperibile</div>
                    <button class="btn btn-sm btn-info btn-verifica-presenze" data-data="@partita.Data.ToString("yyyy-MM-dd")">
                        Presenze Staff
                    </button>
                </div>
            </div>
        </details>

        <div class="pm-actions">
            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
            {
                <a class="pm-act booking-photo-button" href="@Url.Action("Gestisci", "Foto", new { id = partita.Id })" title="Album foto della partita" aria-label="Album foto della partita">&#128247; Foto</a>
            }
            <a class="pm-act" href="@Url.Action("Edit", "Partite", new { id = partita.Id })" title="Modifica">✏️</a>
            <a class="pm-act" href="@Url.Action("Delete", "Partite", new { id = partita.Id })" title="Elimina">🗑️</a>
            <button type="button" class="pm-act btn-invia-recensione" data-id="@partita.Id" title="Invia recensione">⭐</button>
            <button type="button" class="pm-act btn-messaggio-prenotazione" data-id="@partita.Id" title="Messaggio prenotazione">📄</button>
        </div>

    </div>
}
</div>
