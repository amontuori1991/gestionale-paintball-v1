@model List<Full_Metal_Paintball_Carmagnola.Models.Partita>
@using System.Globalization
@{
    ViewData["Title"] = "Visualizzazione Semplificata";
    var it = CultureInfo.GetCultureInfo("it-IT");
    var listinoLabels = ViewBag.ListinoLabels as IDictionary<short, string> ?? new Dictionary<short, string>();
    short currentListinoId = ViewBag.CurrentListinoId is short currentValue ? currentValue : (short)2;
    var partite = Model.Where(p => !p.IsDeleted).ToList();
    var showListino = partite.Any(p => p.Listino != currentListinoId);
    string[] StaffNames(Full_Metal_Paintball_Carmagnola.Models.Partita p) =>
        new[] { p.Staff1, p.Staff2, p.Staff3, p.Staff4 }.Where(n => !string.IsNullOrWhiteSpace(n)).Select(n => n!.Trim()).ToArray();
    var staffColumns = partite.Select(p => StaffNames(p).Length).DefaultIfEmpty(0).Max();
}
<link href="~/css/partite-semplificate-responsive.css" rel="stylesheet" asp-append-version="true" />
<div class="simple-page">
    <h2 class="text-center">Partite Future</h2>
    <div class="text-center mb-3">
        <a class="btn btn-secondary" href="@Url.Action("Index", "Partite")">Torna alle Prenotazioni</a>
    </div>
    <p class="simple-hint">Scorri orizzontalmente per consultare tutte le informazioni.</p>
    <div class="simple-scroll" role="region" aria-label="Partite future, tabella a scorrimento orizzontale" tabindex="0">
        <table class="tabella-semplificata">
            <thead><tr>
                <th scope="col">Data</th><th scope="col">Rep.</th><th scope="col">Info</th><th scope="col">Opzioni</th>
                @if (showListino) { <th scope="col">Listino</th> }
                @for (var i = 1; i <= staffColumns; i++) { <th scope="col">Staff @i</th> }
            </tr></thead>
            <tbody>
                @foreach (var partita in partite)
                {
                    var names = StaffNames(partita);
                    var english = string.Equals(partita.Nazionalita, "ENG", StringComparison.OrdinalIgnoreCase);
                    var stato = partita.CaparraConfermata ? "Confermata" : "In attesa";
                    <tr>
                        <td data-label="Data">
                            <strong>@partita.Data.ToString("ddd dd/MM/yyyy", it)</strong>
                            <div class="simple-date-meta">
                                <time>@partita.OraInizio.ToString(@"hh\:mm")</time>
                                <span role="img" aria-label="@stato" title="@stato">@(partita.CaparraConfermata ? "✅" : "⏳")</span>
                                <img class="simple-flag" src="@(english ? Url.Content("~/img/flag-gb.svg") : Url.Content("~/img/flag-it.svg"))" alt="@(english ? "Inglese" : "Italiano")" title="@(english ? "Inglese" : "Italiano")" width="22" height="15" />
                            </div>
                        </td>
                        <td data-label="Reperibile">@(string.IsNullOrWhiteSpace(partita.Reperibile) ? "In attesa" : partita.Reperibile)</td>
                        <td data-label="Info">
                            <div><strong>@partita.Tipo</strong> · @partita.Durata.ToString("0.##", it) h</div>
                            <div>@partita.NumeroPartecipanti partecipanti</div>
                            <div>Caparra <strong>@partita.Caparra.ToString("0.00", it) €</strong></div>
                        </td>
                        <td data-label="Opzioni">
                            @foreach (var option in new[] { ("Torneo", partita.Torneo), ("Illimitati", partita.ColpiIllimitati), (partita.CacciaDoppia && partita.Caccia ? "Caccia x2" : "Caccia", partita.Caccia) })
                            {
                                <div class="simple-option"><span class="@(option.Item2 ? "simple-yes" : "simple-no")" role="img" aria-label="@(option.Item2 ? "Sì" : "No")">@(option.Item2 ? "✓" : "✕")</span>@option.Item1</div>
                            }
                        </td>
                        @if (showListino)
                        {
                            <td data-label="Listino" class="@(partita.Listino != currentListinoId ? "simple-old-price" : "")">@(listinoLabels.TryGetValue(partita.Listino, out var label) ? label : $"Listino {partita.Listino}")</td>
                        }
                        @for (var i = 0; i < staffColumns; i++)
                        {
                            <td data-label="Staff @(i + 1)">@(i < names.Length ? names[i] : "—")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!partite.Any()) { <p class="text-center p-3">Nessuna partita futura.</p> }
</div>
