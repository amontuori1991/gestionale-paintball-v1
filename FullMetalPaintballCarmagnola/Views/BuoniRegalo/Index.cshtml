@model List<Full_Metal_Paintball_Carmagnola.Models.GiftVoucher>
@{ ViewData["Title"] = "Buoni regalo"; }
<link rel="stylesheet" href="~/css/vouchers.css" asp-append-version="true" />
<section class="voucher-page">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-dark mb-3">&larr; Dashboard</a>
    <header class="voucher-heading"><div><span>FULL METAL / GIFT EXPERIENCE</span><h1>Regala il campo.</h1><p>Un regalo, una squadra, un'esperienza da ricordare.</p></div>@if(User.IsInRole("Admin")){<a asp-action="Crea" class="btn btn-dark">Crea buono</a>}</header>
    @if(TempData["VoucherMessage"] is string message){<div class="alert alert-info" role="status">@message</div>}
    <div class="voucher-panel">
        <form method="get" class="voucher-filters" id="voucher-search">
            <label>Cerca codice, acquirente o destinatario<input name="q" id="voucher-query" value="@ViewBag.Query" maxlength="150" placeholder="FMP-... oppure un nome" /></label>
            <label>Stato<select name="stato"><option value="">Tutti</option>@foreach(var status in new[]{"Disponibile","Da pagare","Riscattato","Scaduto","Annullato"}){<option value="@status" selected="@(ViewBag.Stato == status)">@status</option>}</select></label>
            <button class="btn btn-dark">Cerca</button><a asp-action="Index" class="btn btn-outline-dark">Azzera</a>
        </form>
        <div class="voucher-actions"><button type="button" id="scan-start" class="btn btn-outline-dark">Scansiona con fotocamera</button><button type="button" id="scan-stop" class="btn btn-outline-dark" hidden>Chiudi fotocamera</button><label class="btn btn-outline-dark">Leggi QR da immagine<input id="scan-file" type="file" accept="image/*" hidden /></label></div>
        <div id="voucher-reader"></div><p id="scan-status" role="status" aria-live="polite">La scansione cerca il buono; il riscatto richiede sempre una conferma.</p>
    </div>
    <div class="voucher-list">
        @foreach(var voucher in Model){var details=voucher.Details;
        <article class="voucher-item @(!voucher.Paid ? "voucher-item-unpaid" : "")"><div><span class="voucher-tag">@voucher.Status</span><h2>@details.Recipient</h2><p>@details.Summary</p><small>Acquirente: @details.Buyer</small>
            @if(!voucher.Paid){<p class="voucher-payment-warning"><strong>Da pagare: @details.Amount.ToString("C")</strong><br />Pagamento non confermato. Riscatto bloccato.</p>}
        </div><div class="voucher-item-controls"><strong>@voucher.Code</strong><p>Scade il @voucher.ExpiresOn.ToString("dd/MM/yyyy")</p>
            <div class="voucher-actions"><a asp-action="Dettaglio" asp-route-id="@voucher.Id" class="btn btn-outline-dark">Apri buono</a>
            @if(voucher.Status == "Disponibile"){
                <form asp-action="Stato" method="post" data-confirm="Riscattare l'intero buono @voucher.Code per @details.Recipient? Non sono previsti utilizzi parziali."><input type="hidden" name="id" value="@voucher.Id" /><input type="hidden" name="version" value="@voucher.Version" /><input type="hidden" name="returnToList" value="true" /><button name="operation" value="riscatta" class="btn btn-dark">Riscatta interamente</button></form>
            }else{<button class="btn btn-dark" disabled title="@(voucher.Paid ? voucher.Status : "Prima conferma il pagamento")">Riscatto non disponibile</button>}
            <partial name="_Elimina" model="voucher" />
            </div>
        </div></article>}
    </div>
    @if(Model.Count==0){<p class="voucher-panel">Nessun buono trovato. Puoi cercare il codice anche senza fotocamera.</p>}
    <nav class="voucher-actions" aria-label="Pagine buoni">
        @if(ViewBag.Page>1){<a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-stato="@ViewBag.Stato" asp-route-page="@(ViewBag.Page-1)" class="btn btn-outline-dark">Precedenti</a>}
        @if(ViewBag.HasNext){<a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-stato="@ViewBag.Stato" asp-route-page="@(ViewBag.Page+1)" class="btn btn-outline-dark">Successivi</a>}
    </nav>
    @if(User.IsInRole("Admin")){
    <details class="voucher-panel" open="@(!ViewBag.HasSignature)"><summary>Firma aziendale: @(ViewBag.HasSignature ? "configurata" : "da caricare")</summary><p>Carica Firma_Alex.jpeg (PNG/JPG, massimo 2 MB). La firma viene conservata nel database, non in una cartella pubblica. Sostituirla cambia la firma nelle successive esportazioni.</p><form asp-action="Firma" method="post" enctype="multipart/form-data"><input type="file" name="file" accept="image/png,image/jpeg" required /><button class="btn btn-dark mt-2">Salva firma</button></form></details>
    }
</section>
<script src="~/lib/html5-qrcode/html5-qrcode.min.js" asp-append-version="true" defer></script>
<script src="~/js/vouchers.js" asp-append-version="true" defer></script>
