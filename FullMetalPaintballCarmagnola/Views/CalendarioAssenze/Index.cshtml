@using Full_Metal_Paintball_Carmagnola.Models
@model List<AssenzaCalendario>
@using System.Globalization

@{
    ViewData["Title"] = "Calendario Assenze";
    var chiusureCampo = ViewBag.ChiusureCampo as Dictionary<DateTime, CampoChiusura> ?? new Dictionary<DateTime, CampoChiusura>();
}

<style>
    .calendario-campo-chiuso {
        background-color: #6c757d !important;
        color: #ffffff;
        font-weight: 800;
        text-align: center;
    }

    .calendario-campo-chiuso-motivo {
        display: block;
        font-size: .78rem;
        font-weight: 600;
        opacity: .9;
    }
</style>

<div class="roster-page">
    <header class="roster-heading">
        <span class="roster-eyebrow">Organizzazione del campo</span>
        <h2>Calendario Assenze</h2>
        <p>Ogni giornata, il suo team. Consulta la reperibilità e segnala le assenze.</p>
    </header>

    <div class="d-flex justify-content-center mb-3">
        <input type="search" id="filtroCalendario" aria-label="Cerca nel calendario assenze" placeholder="Cerca giorno, data o nome..." class="form-control roster-search" />
    </div>

    <div class="roster-days">
                @foreach (var giorno in Model)
                {
                    var giornoSet = giorno.Data.ToString("dddd", new CultureInfo("it-IT"));
                    var campoChiuso = chiusureCampo.TryGetValue(giorno.Data.Date, out var chiusuraCampo);
                    var repClass = giorno.Reperibile == "In attesa" ? "calendario-bg-warning"
                    : giorno.Reperibile == "Nessuno" ? "calendario-bg-danger" : "calendario-bg-success";
                    if (campoChiuso)
                    {
                        repClass = "calendario-campo-chiuso";
                    }

                    <article class="roster-day">
                        <div data-label="Giorno" class="roster-field ">@giornoSet</div>
                        <div data-label="Data" class="roster-field "><time datetime="@giorno.Data.ToString("yyyy-MM-dd")" data-search-date="@giorno.Data.ToString("dd/MM/yyyy")">@giorno.Data.ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("it-IT"))</time></div>

                        <div data-label="Reperibile" class="roster-field @repClass">
                            @if (campoChiuso)
                            {
                                <span>Campo chiuso</span>
                                @if (!string.IsNullOrWhiteSpace(chiusuraCampo?.Motivo))
                                {
                                    <span class="calendario-campo-chiuso-motivo">@chiusuraCampo.Motivo</span>
                                }
                            }
                            else
                            {
                                <select class="reperibile-select" aria-label="Reperibile del @giorno.Data.ToString("dd/MM/yyyy")" data-id="@giorno.Id">
                                    <option value="In attesa" selected="@(giorno.Reperibile == "In attesa" ? "selected" : null)">In attesa</option>
                                    <option value="Montuo" selected="@(giorno.Reperibile == "Montuo" ? "selected" : null)">Montuo</option>
                                    <option value="Flavio" selected="@(giorno.Reperibile == "Flavio" ? "selected" : null)">Flavio</option>
                                    <option value="Bosax" selected="@(giorno.Reperibile == "Bosax" ? "selected" : null)">Bosax</option>
                                    <option value="Nessuno" selected="@(giorno.Reperibile == "Nessuno" ? "selected" : null)">Nessuno</option>
                                </select>
                            }
                        </div>

                        @foreach (var membro in new[] { "Montuo", "Flavio", "Bosax" })
                        {
                            if (campoChiuso)
                            {
                                <div data-label="@membro" class="roster-field calendario-campo-chiuso">
                                    Campo chiuso
                                </div>
                                continue;
                            }

                            var assenza = membro switch
                            {
                                "Montuo" => giorno.Montuo,
                                "Flavio" => giorno.Flavio,
                                "Bosax" => giorno.Bosax,
                                _ => null
                            };

                            var bgClass = assenza == "assente" ? "calendario-bg-danger" : "calendario-bg-warning";

                            <div data-label="@membro" class="roster-field @bgClass">
                                <select class="assenza-select" aria-label="Assenza @membro del @giorno.Data.ToString("dd/MM/yyyy")" data-id="@giorno.Id" data-nome="@membro">
                                    <option value="" selected="@(string.IsNullOrWhiteSpace(assenza) ? "selected" : null)">Non segnalata</option>
                                    <option value="assente" selected="@(assenza == "assente" ? "selected" : null)">assente</option>
                                </select>
                            </div>
                        }
                    </article>
                }
    </div>
    <p class="roster-empty" hidden>Nessuna giornata corrisponde alla ricerca.</p>
</div>

<link href="~/css/staff-roster.css" rel="stylesheet" asp-append-version="true" />

@section Scripts {
    <script src="~/js/staff-roster.js" asp-append-version="true"></script>
    <script>
        $(function () {
            $('.reperibile-select').on('change', function () {
                const sel = $(this);
                const id = sel.data('id');
                const val = sel.val();
                const td = sel.closest('.roster-field');

                $.post('/CalendarioAssenze/AggiornaReperibile', { id: id, reperibile: val })
                    .done(() => {
                        td.removeClass('calendario-bg-success calendario-bg-danger calendario-bg-warning');
                        if (val === 'Nessuno') td.addClass('calendario-bg-danger');
                        else if (val === 'In attesa') td.addClass('calendario-bg-warning');
                        else td.addClass('calendario-bg-success');
                    })
                    .fail(() => fmpNotify("Errore durante il salvataggio della reperibilità.", "error"));
            });

            $('.assenza-select').on('change', function () {
                const sel = $(this);
                const id = sel.data('id');
                const nome = sel.data('nome');
                const val = sel.val();
                const td = sel.closest('.roster-field');

                $.post('/CalendarioAssenze/AggiornaAssenza', { id: id, nome: nome, stato: val })
                    .done(() => {
                        td.removeClass('calendario-bg-success calendario-bg-danger calendario-bg-warning');
                        if (val === "assente") td.addClass('calendario-bg-danger');
                        else td.addClass('calendario-bg-warning');
                    })
                    .fail(() => fmpNotify("Errore durante il salvataggio dell'assenza.", "error"));
            });

        });
    </script>
}
