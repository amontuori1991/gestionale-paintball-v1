@model Full_Metal_Paintball_Carmagnola.Models.FlyerRequest
@using Full_Metal_Paintball_Carmagnola.Models
@{ ViewData["Title"] = "Crea Volantini"; var company = (CompanyProfile)ViewBag.Company; }
<link rel="stylesheet" href="~/css/flyers.css" asp-append-version="true" />
<section class="flyer-studio">
    <header class="studio-heading"><div><span>FULL METAL / CREATIVE STUDIO</span><h1>Fatti notare.</h1><p>Il tuo prossimo evento in un volantino. Pronto da stampare o condividere.</p></div><a asp-controller="ProfiloAzienda" asp-action="Index" class="btn btn-outline-dark">Profilo Azienda</a></header>
    @if (string.IsNullOrWhiteSpace(company.Name)) { <div class="alert alert-warning">Compila il Profilo Azienda prima di esportare il volantino.</div> }
    <div class="studio-grid">
        <form id="flyer-form" asp-action="Genera" method="post" class="studio-controls">
            @Html.AntiForgeryToken()
            <h2>01 / La tua idea</h2>
            <div class="studio-presets"><button type="button" data-preset="party">Festa</button><button type="button" data-preset="challenge">Sfida tra amici</button><button type="button" data-preset="event">Open day</button></div>
            <label asp-for="Title">Titolo principale</label><input asp-for="Title" maxlength="65" required />
            <label asp-for="Subtitle">Sottotitolo</label><input asp-for="Subtitle" maxlength="120" required />
            <label asp-for="Badge">Etichetta in alto</label><input asp-for="Badge" maxlength="40" />
            <label asp-for="Offer">Fascia promozionale</label><input asp-for="Offer" maxlength="60" /><small>Puoi inserire una proposta o un prezzo. Verifica sempre importi e condizioni.</small>
            <label asp-for="Event">Data, orario o occasione</label><input asp-for="Event" maxlength="90" placeholder="Es. Domenica 18 ottobre, dalle 10 alle 18" />
            <label asp-for="Details">Descrizione e condizioni</label><textarea asp-for="Details" maxlength="320" rows="4"></textarea>
            <label asp-for="CallToAction">Invito all'azione</label><input asp-for="CallToAction" maxlength="45" required />
            <h2>02 / Il carattere</h2>
            <label asp-for="Theme">Palette</label><select asp-for="Theme"><option value="impact">Impact / lime e antracite</option><option value="sun">Sun / crema e arancio</option><option value="ice">Ice / turchese e corallo</option></select>
            <div class="studio-company"><strong>@company.Name</strong><p>Logo globale e dati di contatto vengono inseriti automaticamente. Se il sito &egrave; compilato, viene generato anche il QR.</p></div>
            <button type="submit" class="btn btn-dark w-100">Aggiorna anteprima</button>
        </form>
        <aside class="studio-preview">
            <div class="studio-preview-top"><strong>ANTEPRIMA A4</strong><span>Stessa impaginazione del file finale</span></div>
            <div class="studio-paper"><img id="flyer-preview" alt="Anteprima del volantino" hidden /><p id="flyer-placeholder">La tua idea prende forma qui.</p></div>
            <p id="flyer-status" role="status" aria-live="polite"></p>
            <div class="studio-export"><button type="button" data-export="pdf">Scarica PDF A4</button><button type="button" data-export="jpg">Scarica JPG HD</button></div>
            <small>PDF A4 a pagina singola. JPG 2480 &times; 3508 pixel, adatto a stampa A4 a circa 300 dpi. Senza abbondanza: chiedi alla tipografia se necessaria.</small>
        </aside>
    </div>
</section>
<script src="~/js/flyers.js" asp-append-version="true" defer></script>
